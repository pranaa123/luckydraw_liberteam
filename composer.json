{
  "name": "doorprize/aplikasi-baru",
  "description": "Aplikasi doorprize PHP modular",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "dev": "php -d upload_max_filesize=20M -d post_max_size=21M -S 127.0.0.1:8091 -t public public/router.php"
  }
}
