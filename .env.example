APP_NAME=Doorprize
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=Asia/Makassar
APP_URL=

# Biarkan kosong untuk PostgreSQL portabel lokal melalui npm run dev.
# Isi hanya jika memakai PHP native dan database PostgreSQL khusus aplikasi baru.
# Jangan gunakan kredensial database aplikasi lama.
DB_DSN=
DB_USER=
DB_PASSWORD=

# Wajib untuk deployment; base64 dari 32 byte acak. Jangan taruh pada frontend.
# Lokal membuat storage/keys/local.key bila nilai ini kosong.
APP_ENCRYPTION_KEY=

# Cloud memakai bucket privat dan URL upload bertanda tangan. Secret hanya server.
BACKGROUND_DRIVER=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BACKGROUND_BUCKET=doorprize-backgrounds

# Untuk PostgreSQL Supabase nanti: gunakan pooler + sslmode=require pada DB_DSN.
# Kredensial/project khusus aplikasi baru; jangan mengambil milik aplikasi lama.
